<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.practicafiledirectorychooser1.MenuRegistroController">
    <children>
        <BorderPane prefHeight="25.0" prefWidth="601.0">
            <bottom>
                <MenuBar fx:id="menuBar" BorderPane.alignment="CENTER">
                    <menus>
                        <Menu fx:id="menuCatalogo" mnemonicParsing="false" text="Catalogo">
                            <items>
                                <MenuItem fx:id="itemRegistroProyecto" mnemonicParsing="false" onAction="#abrirRegistroProyecto" text="Registro Proyecto" />
                            </items>
                        </Menu>
                        <Menu fx:id="menuArchivo" mnemonicParsing="false" text="Archivo">
                            <items>
                                <MenuItem fx:id="itemSalir" mnemonicParsing="false" onAction="#salir" text="Salir" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
            </bottom>
        </BorderPane>
        <VBox layoutX="223.0" layoutY="186.0" prefHeight="200.0" prefWidth="236.0">
            <children>
                <Label prefHeight="17.0" prefWidth="242.0" text="Bienvenido/a" textAlignment="CENTER" />
                <Label text="Utilice el menú superior para navegar por la aplicación." />
            </children>
        </VBox>
    </children>

</AnchorPane>